@page "/login"

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<div class="auth-page">

    <div class="auth-card">

        <!-- Brand -->
        <div class="auth-brand">
            <div class="auth-logo">
                ₹
            </div>

            <h1>Finance Management</h1>
            <p>Manage your finances with ease</p>
        </div>

        <!-- Heading -->
        <div class="auth-heading">
            <h2>Welcome back</h2>
            <p>Sign in to continue to your account</p>
        </div>

        <!-- Error -->
        @if (Error)
        {
            <div class="alert alert-danger auth-alert">
                <i class="bi bi-exclamation-circle me-2"></i>
                Invalid email or password.
            </div>
        }

        <!-- Login Form -->
        <form method="post" action="/account/login">

            <div class="auth-field">
                <label class="form-label">
                    <i class="bi bi-envelope me-2"></i>
                    Email
                </label>

                <input type="email"
                       name="email"
                       class="form-control"
                       placeholder="Enter your email"
                       required />
            </div>

            <div class="auth-field">
                <label class="form-label">
                    <i class="bi bi-lock me-2"></i>
                    Password
                </label>

                <input type="password"
                       name="password"
                       class="form-control"
                       placeholder="Enter your password"
                       required />
            </div>

            <button type="submit" class="btn btn-primary auth-submit">
                <i class="bi bi-box-arrow-in-right me-2"></i>
                Login
            </button>

        </form>

        <!-- Register -->
        <div class="auth-footer">
            <span>Don't have an account?</span>
            <a href="/register">Create an account</a>
            <a href="/forgot-password">Forgot Password?</a>
        </div>

        <!-- Security -->
        <div class="auth-security">
            <i class="bi bi-shield-check me-1"></i>
            Secure financial management
        </div>

    </div>

</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorParameter { get; set; }

    private bool Error => ErrorParameter == "1";

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var role =
                authState.User.FindFirst(ClaimTypes.Role)?.Value;

            if (role == "Admin")
            {
                Navigation.NavigateTo("/admin", replace: true);
            }
            else
            {
                Navigation.NavigateTo("/dashboard", replace: true);
            }
        }
    }
}
