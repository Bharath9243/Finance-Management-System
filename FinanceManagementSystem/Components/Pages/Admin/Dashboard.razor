@page "/admin"

@using FinanceManagementSystem.Models
@using FinanceManagementSystem.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Admin")]

@inject ILoanService LoanService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Admin Dashboard</PageTitle>

<div class="admin-dashboard-page">

    <div class="admin-dashboard-header">
        <div>
            <h1>Admin Dashboard</h1>
            <p>Overview of loan applications and loan activity.</p>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="admin-dashboard-section admin-loading">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger admin-alert">
            @ErrorMessage
        </div>
    }
    else
    {
        <div class="admin-stats-grid">

            <div class="admin-stat-card">
                <div class="admin-stat-icon">
                    <i class="bi bi-file-earmark-text"></i>
                </div>
                <div>
                    <span class="admin-stat-label">Total Applications</span>
                    <strong class="admin-stat-value">@TotalLoans</strong>
                </div>
            </div>

            <div class="admin-stat-card">
                <div class="admin-stat-icon admin-icon-warning">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <span class="admin-stat-label">Pending</span>
                    <strong class="admin-stat-value">@PendingLoans</strong>
                </div>
            </div>

            <div class="admin-stat-card">
                <div class="admin-stat-icon admin-icon-primary">
                    <i class="bi bi-bank"></i>
                </div>
                <div>
                    <span class="admin-stat-label">Active Loans</span>
                    <strong class="admin-stat-value">@ActiveLoans</strong>
                </div>
            </div>

            <div class="admin-stat-card">
                <div class="admin-stat-icon admin-icon-success">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <span class="admin-stat-label">Paid Loans</span>
                    <strong class="admin-stat-value">@PaidLoans</strong>
                </div>
            </div>

            <div class="admin-stat-card">
                <div class="admin-stat-icon admin-icon-danger">
                    <i class="bi bi-x-circle"></i>
                </div>
                <div>
                    <span class="admin-stat-label">Rejected Loans</span>
                    <strong class="admin-stat-value">@RejectedLoans</strong>
                </div>
            </div>

            <div class="admin-stat-card">
                <div class="admin-stat-icon admin-icon-success">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div>
                    <span class="admin-stat-label">Total Disbursed</span>
                    <strong class="admin-stat-value">
                        ₹@TotalDisbursed.ToString("N2")
                    </strong>
                </div>
            </div>

            <div class="admin-stat-card">
                <div class="admin-stat-icon admin-icon-primary">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div>
                    <span class="admin-stat-label">Total Outstanding</span>
                    <strong class="admin-stat-value">
                        ₹@TotalOutstanding.ToString("N2")
                    </strong>
                </div>
            </div>

        </div>

        <div class="admin-dashboard-section">

            <div class="admin-section-header">
                <div>
                    <h2>Recent Loan Applications</h2>
                    <p>Latest loan applications submitted by users.</p>
                </div>

                <a href="/admin/pending-loans" class="admin-manage-button">
                    <i class="bi bi-gear"></i>
                    Pending Loans
                </a>
            </div>

            @if (!RecentLoans.Any())
            {
                <div class="admin-empty">
                    <div class="admin-empty-icon">
                        <i class="bi bi-file-earmark-x"></i>
                    </div>

                    <h3>No loan applications</h3>

                    <p>No loan applications found.</p>
                </div>
            }
            else
            {
                <div class="admin-table-wrapper">

                    <table class="admin-table">

                        <thead>
                            <tr>
                                <th>Loan</th>
                                <th>User</th>
                                <th>Principal</th>
                                <th>Status</th>
                                <th>Created</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var loan in RecentLoans)
                            {
                                <tr>
                                    <td class="admin-loan-id">
                                        #@loan.LoanId
                                    </td>

                                    <td>
                                        User #@loan.UserId
                                    </td>

                                    <td class="admin-amount">
                                        ₹@loan.PrincipalAmount.ToString("N2")
                                    </td>

                                    <td>
                                        <span class="admin-status @GetStatusClass(loan.Status)">
                                            @loan.Status
                                        </span>
                                    </td>

                                    <td>
                                        @(loan.CreatedAt.ToLocalTime()
                                            .ToString("dd MMM yyyy"))
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }

        </div>
    }
</div>

@code {

    private IEnumerable<Loan> Loans =
        Enumerable.Empty<Loan>();

    private IEnumerable<Loan> RecentLoans =>
        Loans
            .OrderByDescending(l => l.CreatedAt)
            .Take(5);

    private bool IsLoading = true;

    private string? ErrorMessage;

    private int TotalLoans =>
        Loans.Count();

    private int PendingLoans =>
        Loans.Count(l => l.Status == "Pending");

    private int ActiveLoans =>
        Loans.Count(l => l.Status == "Active");

    private int PaidLoans =>
        Loans.Count(l => l.Status == "Paid");

    private int RejectedLoans =>
        Loans.Count(l => l.Status == "Rejected");

    private decimal TotalDisbursed =>
        Loans
            .Where(l =>
                l.Status == "Active" ||
                l.Status == "Paid")
            .Sum(l => l.PrincipalAmount);

    private decimal TotalOutstanding =>
    Loans
        .Where(l => l.Status == "Active")
        .Sum(l => l.OutstandingAmount);

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;

            Loans =
                await LoanService.GetAllLoansAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning text-dark",
            "Active" => "bg-primary",
            "Paid" => "bg-success",
            "Rejected" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}