@page "/expenses"

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using FinanceManagementSystem.Models
@using FinanceManagementSystem.Services.Interfaces

@attribute [Authorize(Roles = "User")]

@inject IAccountService AccountService
@inject ITransactionService TransactionService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Expenses</PageTitle>

<div class="income-expenses-page">

    <div class="income-expenses-header">
        <div>
            <h1>Expenses</h1>
            <p>View all your expense transactions</p>
        </div>
    </div>

    <div class="income-expenses-summary">
        <div class="summary-card expense-summary-card">
            <div class="summary-icon">
                <i class="bi bi-arrow-up-circle"></i>
            </div>

            <div>
                <span class="summary-label">Total Expenses</span>
                <strong>₹@TotalExpenses.ToString("N2")</strong>
            </div>
        </div>
    </div>

    <div class="income-expenses-section">

        <div class="section-heading">
            <div>
                <h3>
                    <i class="bi bi-list-ul me-2"></i>
                    Expense Transactions
                </h3>

                <p>
                    All expenses recorded across your accounts
                </p>
            </div>
        </div>

        <div class="income-expenses-filter">

            <label class="form-label">
                Filter by Account
            </label>

            <select class="form-select"
                    @bind="selectedAccountId"
                    @bind:after="FilterTransactions">

                <option value="0">All Accounts</option>

                @foreach (var account in accounts)
                {
                    <option value="@account.AccountId">
                        @account.AccountName
                    </option>
                }

            </select>

        </div>

        @if (expenseTransactions == null)
        {
            <div class="income-expenses-empty">
                <i class="bi bi-hourglass-split"></i>
                <p>Loading expense transactions...</p>
            </div>
        }
        else if (!expenseTransactions.Any())
        {
            <div class="income-expenses-empty">
                <i class="bi bi-wallet2"></i>
                <p>No expense transactions found.</p>
            </div>
        }
        else
        {
            <div class="income-expenses-table-wrapper">

                <table class="income-expenses-table">

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Description</th>
                            <th>Account</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var transaction in expenseTransactions)
                        {
                            <tr>

                                <td>
                                    @transaction.TransactionDate.ToLocalTime()
                                </td>

                                <td>
                                    @(transaction.CategoryName ?? "-")
                                </td>

                                <td class="income-expenses-amount expense-amount">
                                    -₹@transaction.Amount.ToString("N2")
                                </td>

                                <td>
                                    @(transaction.Description ?? "-")
                                </td>

                                <td>
                                    @(accounts
                                        .FirstOrDefault(a =>
                                            a.AccountId == transaction.AccountId)
                                        ?.AccountName ?? "Unknown")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

@code
{
    private IEnumerable<Account> accounts =
        Enumerable.Empty<Account>();

    private IEnumerable<Transaction> allExpenseTransactions =
        Enumerable.Empty<Transaction>();

    private IEnumerable<Transaction> expenseTransactions =
        Enumerable.Empty<Transaction>();

    private int selectedAccountId;

    private decimal TotalExpenses =>
        expenseTransactions.Sum(t => t.Amount);

    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
        await LoadTransactions();
    }

    private async Task LoadAccounts()
    {
        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var user = authState.User;

        var userIdClaim =
            user.FindFirst(ClaimTypes.NameIdentifier);

        if (userIdClaim == null)
        {
            return;
        }

        var userId = int.Parse(userIdClaim.Value);

        accounts =
            await AccountService.GetMyAccountsAsync(userId);
    }

    private async Task LoadTransactions()
    {
        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var user = authState.User;

        var userIdClaim =
            user.FindFirst(ClaimTypes.NameIdentifier);

        if (userIdClaim == null)
        {
            return;
        }

        var userId = int.Parse(userIdClaim.Value);

        var transactions =
            await TransactionService
                .GetMyTransactionsAsync(userId);

        allExpenseTransactions =
            transactions.Where(t =>
                t.TransactionType == "Expense");

        FilterTransactions();
    }

    private void FilterTransactions()
    {
        if (selectedAccountId == 0)
        {
            expenseTransactions =
                allExpenseTransactions;
        }
        else
        {
            expenseTransactions =
                allExpenseTransactions.Where(t =>
                    t.AccountId == selectedAccountId);
        }
    }
}


