@page "/accounts"

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using FinanceManagementSystem.Models
@using FinanceManagementSystem.Services.Interfaces

@attribute [Authorize(Roles = "User")]

@inject IAccountService AccountService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>My Accounts</PageTitle>

<h1>My Accounts</h1>

<div class="account-section">

    <div class="section-heading">
        <div>
            <h3>Create Account</h3>
            <p class="text-muted mb-0">
                Add a new account to manage your finances
            </p>
        </div>
    </div>

    <EditForm Model="accountModel" OnValidSubmit="CreateAccount">

        <div class="account-form-grid">

            <div>
                <label class="form-label">Account Name</label>
                <InputText class="form-control"
                           @bind-Value="accountModel.AccountName"
                           placeholder="e.g. Main Savings" />
            </div>

            <div>
                <label class="form-label">Account Type</label>
                <InputSelect class="form-select"
                             @bind-Value="accountModel.AccountType">
                    <option value="">Select type</option>
                    <option value="Savings">Savings</option>
                    <option value="Checking">Checking</option>
                    <option value="Cash">Cash</option>
                </InputSelect>
            </div>

        </div>

        <div class="form-action">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-plus-lg me-2"></i>
                Create Account
            </button>
        </div>

    </EditForm>

    @if (!string.IsNullOrEmpty(accountMessage))
    {
        <div class="account-message">
            @accountMessage
        </div>
    }

</div>

<hr />

<div class="account-section">

    <div class="section-heading">
        <div>
            <h3>Deposit Money</h3>
            <p class="text-muted mb-0">
                Add money to one of your accounts
            </p>
        </div>
    </div>

    <EditForm Model="depositModel" OnValidSubmit="Deposit">

        <div class="account-form-grid">

            <div>
                <label class="form-label">Account</label>
                <InputSelect class="form-select"
                             @bind-Value="depositModel.AccountId">
                    <option value="0">Select Account</option>

                    @foreach (var account in accounts ?? Enumerable.Empty<Account>())
                    {
                        <option value="@account.AccountId">
                            @account.AccountName - ₹@account.Balance.ToString("N2")
                        </option>
                    }
                </InputSelect>
            </div>

            <div>
                <label class="form-label">Amount</label>
                <InputNumber class="form-control"
                             @bind-Value="depositModel.Amount"
                             placeholder="Enter amount" />
            </div>

        </div>

        <div class="mt-3">
            <label class="form-label">Description</label>
            <InputText class="form-control"
                       @bind-Value="depositModel.Description"
                       placeholder="e.g. Salary, cash deposit" />
        </div>

        <div class="form-action">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-arrow-down-circle me-2"></i>
                Deposit Money
            </button>
        </div>

    </EditForm>

    @if (!string.IsNullOrEmpty(depositMessage))
    {
        <div class="account-message">
            @depositMessage
        </div>
    }

</div>

<hr />

<div class="account-section">

    <div class="section-heading">
        <div>
            <h3>Withdraw Money</h3>
            <p class="text-muted mb-0">
                withdraw money from your available balance
            </p>
        </div>
    </div>

    <div class="account-form-grid">

        <div>
            <label class="form-label">Account</label>
            <select class="form-select" @bind="withdrawAccountId">
                <option value="0">Select Account</option>

                @foreach (var account in accounts ?? Enumerable.Empty<Account>())
                {
                    <option value="@account.AccountId">
                        @account.AccountName - ₹@account.Balance.ToString("N2")
                    </option>
                }
            </select>
        </div>

        <div>
            <label class="form-label">Amount</label>
            <input class="form-control"
                   type="number"
                   step="0.01"
                   min="0"
                   @bind="withdrawAmount"
                   placeholder="Enter amount" />
        </div>

    </div>

    <div class="mt-3">
        <label class="form-label">Description</label>
        <input class="form-control"
               @bind="withdrawDescription"
               placeholder="e.g. Cash withdrawal" />
    </div>

    <div class="form-action">
        <button type="button"
                class="btn btn-danger"
                @onclick="WithdrawMoneyAsync">
            <i class="bi bi-arrow-up-circle me-2"></i>
            Withdraw Money
        </button>
    </div>

    @if (!string.IsNullOrEmpty(withdrawMessage))
    {
        <div class="account-message">
            @withdrawMessage
        </div>
    }

</div>

<hr />

<div class="account-section">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">My Accounts</h3>
            <p class="text-muted mb-0">
                Your accounts and available balances
            </p>
        </div>

        @if (accounts != null)
        {
            <span class="account-type">
                @accounts.Count() account@(accounts.Count() == 1 ? "" : "s")
            </span>
        }
    </div>

    @if (accounts == null)
    {
        <p class="text-muted">Loading accounts...</p>
    }
    else if (!accounts.Any())
    {
        <div class="text-center py-4">
            <i class="bi bi-wallet2 fs-1 text-muted"></i>
            <p class="mt-3 mb-0 text-muted">
                You don't have any accounts yet.
            </p>
        </div>
    }
    else
    {
        <div class="account-cards-grid">

            @foreach (var account in accounts)
            {
                <div class="account-card">

                    <div class="account-card-header">

                        <div class="account-icon">
                            @if (account.AccountType == "Savings")
                            {
                                <i class="bi bi-piggy-bank-fill"></i>
                            }
                            else if (account.AccountType == "Checking")
                            {
                                <i class="bi bi-credit-card-fill"></i>
                            }
                            else
                            {
                                <i class="bi bi-cash-stack"></i>
                            }
                        </div>

                        <span class="account-type">
                            @account.AccountType
                        </span>

                    </div>

                    <h4>@account.AccountName</h4>

                    <span class="balance-label">
                        Available Balance
                    </span>

                    <div class="account-balance">
                        ₹@account.Balance.ToString("N2")
                    </div>

                </div>
            }

        </div>
    }

</div>

@code
{
    private IEnumerable<Account>? accounts;

    private AccountModel accountModel = new();

    private DepositModel depositModel = new();

    private int withdrawAccountId;
    private decimal withdrawAmount;
    private string? withdrawDescription;
    private string? withdrawMessage;

    private string? accountMessage;
    private string? depositMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
    }

    private async Task LoadAccounts()
    {
        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var user = authState.User;

        var userIdClaim =
            user.FindFirst(ClaimTypes.NameIdentifier);

        if (userIdClaim == null)
        {
            return;
        }

        var userId = int.Parse(userIdClaim.Value);

        accounts =
            await AccountService.GetMyAccountsAsync(userId);
    }

    private async Task CreateAccount()
    {
        accountMessage = null;

        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var user = authState.User;

        var userIdClaim =
            user.FindFirst(ClaimTypes.NameIdentifier);

        if (userIdClaim == null)
        {
            return;
        }

        var userId = int.Parse(userIdClaim.Value);

        try
        {
            await AccountService.CreateAccountAsync(
                userId,
                accountModel.AccountName,
                accountModel.AccountType);

            accountMessage = "Account created successfully.";

            accountModel = new();

            await LoadAccounts();
        }
        catch (ArgumentException ex)
        {
            accountMessage = ex.Message;
        }
    }

    private async Task Deposit()
    {
        depositMessage = null;

        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var user = authState.User;

        var userIdClaim =
            user.FindFirst(ClaimTypes.NameIdentifier);

        if (userIdClaim == null)
        {
            return;
        }

        var userId = int.Parse(userIdClaim.Value);

        try
        {
            await AccountService.DepositAsync(
                userId,
                depositModel.AccountId,
                depositModel.Amount,
                depositModel.Description);

            depositMessage = "Deposit successful.";

            depositModel = new();

            await LoadAccounts();
        }
        catch (ArgumentException ex)
        {
            depositMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            depositMessage = ex.Message;
        }
    }

    private async Task WithdrawMoneyAsync()
    {
        try
        {
            withdrawMessage = null;

            if (withdrawAccountId == 0)
            {
                withdrawMessage = "Please select an account.";
                return;
            }

            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user = authState.User;

            var userIdClaim =
                user.FindFirst(ClaimTypes.NameIdentifier);

            if (userIdClaim == null)
            {
                withdrawMessage = "User is not authenticated.";
                return;
            }

            var userId = int.Parse(userIdClaim.Value);

            await AccountService.WithdrawAsync(
                userId,
                withdrawAccountId,
                withdrawAmount,
                withdrawDescription);

            withdrawMessage = "Withdrawal successful.";

            withdrawAccountId = 0;
            withdrawAmount = 0;
            withdrawDescription = null;

            await LoadAccounts();
        }
        catch (Exception ex)
        {
            withdrawMessage = ex.Message;
        }
    }

    private class AccountModel
    {
        public string AccountName { get; set; } = string.Empty;

        public string AccountType { get; set; } = string.Empty;
    }

    private class DepositModel
    {
        public int AccountId { get; set; }

        public decimal Amount { get; set; }

        public string? Description { get; set; }
    }
}